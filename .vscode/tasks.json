{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Arduino Uno",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "arduino:avr:uno",
        "--libraries",
        "libraries",
        "--output-dir",
        "build",
        "sketch"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
